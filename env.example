# Copy to .env and fill in real values; .env is gitignored.
# After creating it: `chmod 600 .env` — gitignore protects against `git add`,
# but the file defaults to 0644 which lets every local user on the host read
# the admin token. The umask trick: `(umask 077 && cp env.example .env)`.

# --- REQUIRED ---

# Base URL of the gatekeeper instance you want to inspect.
GATEKEEPER_BASE_URL=https://gatekeeper.example.com

# Aegis bearer token belonging to a user with console-admin role on the
# target gatekeeper. The MCP makes every admin call with this token.
GATEKEEPER_ADMIN_TOKEN=aegis-bearer-token-here

# --- OPTIONAL ---

# HTTP timeout for calls into gatekeeper (seconds). Default: 10
# GATEKEEPER_REQUEST_TIMEOUT_SECONDS=10

# Transport: "stdio" for local dev with Claude Code; "streamable-http" for
# remote/Docker; "sse" if your client only supports SSE.
# Default in this file: stdio.  NOTE: the Docker image overrides this to
# "streamable-http" — see Dockerfile. You only need to set this here if
# you're running mcp-gatekeeper directly (not via Docker).
# MCP_TRANSPORT=stdio

# Bind address for streamable-http / sse. The Docker image defaults to
# 127.0.0.1 (safe-by-default) — docker-compose.example.yml overrides it
# to 0.0.0.0 so the host can reach the container. Local stdio mode ignores
# these.
# MCP_HOST=127.0.0.1
# MCP_PORT=7872

# FastMCP-specific aliases (required when running streamable-http behind nginx —
# FastMCP's constructor defaults override the generic MCP_* vars).
# FASTMCP_HOST=127.0.0.1
# FASTMCP_PORT=7872
